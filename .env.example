# Copy to .env. Everything is optional for a quick local try-out.

# Where browsers reach the relay. Must work from the devices using the app (not just this host).
#   local only:      ws://localhost:8787
#   on your network: ws://192.168.1.20:8787   (works for plain http:// pages only)
#   with the https profile (below): wss://dinner.example.com/sync
RELAY_URL=ws://localhost:8787

# Host ports
APP_PORT=8080
RELAY_PORT=8787

# Which version of the Sync PWA Framework the relay is built from (branch, tag or commit).
SYNC_REF=master

# Only for `docker compose --profile https`: the domain pointing at this machine.
# DOMAIN=dinner.example.com
